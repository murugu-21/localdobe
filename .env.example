PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
# Same-origin reverse proxy (PostHog "managed reverse proxy" CNAME) so ad-blockers
# don't drop the SDK. Falls back to https://us.i.posthog.com, which most
# blocklists stop. See DEPLOY.md.
PUBLIC_POSTHOG_HOST=https://e.localdobe.com

# Optional, for production builds only: upload source maps to PostHog so error
# stack traces are de-minified. Personal API key with error-tracking write
# access, plus the project id (posthog.com → project settings). Deliberately no
# PUBLIC_ prefix — these must stay server-side, never in client code. See
# DEPLOY.md.
# POSTHOG_API_KEY=
# POSTHOG_PROJECT_ID=
