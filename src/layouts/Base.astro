---
import '../styles/global.css';
import { pwaInfo } from 'virtual:pwa-info';
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  jsonLd?: object[];
}
const { title, description, canonicalPath, jsonLd = [] } = Astro.props;
// Inlined at build time — set PUBLIC_CLARITY_PROJECT_ID as a Cloudflare build
// variable (the site is static; runtime Worker vars never reach this code).
const clarityId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
const canonicalHref = new URL(canonicalPath, Astro.site).href;
const canonical = canonicalHref.endsWith('/') ? canonicalHref : `${canonicalHref}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Blocking (no-FOUC) theme init: an explicit user choice in localStorage wins;
      // otherwise follow the OS/browser prefers-color-scheme. Runs before first paint —
      // must stay `is:inline` so Astro doesn't defer/bundle it as a module.
      (function () {
        var stored = localStorage.getItem('theme');
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
        var meta = document.getElementById('theme-color-meta');
        if (meta) meta.setAttribute('content', dark ? '#0a0a0a' : '#2563eb');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta id="theme-color-meta" name="theme-color" content="#2563eb" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="localdobe blog" href="/rss.xml" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    {clarityId && (
      <script
        is:inline
        set:html={`(function(w,d,id){
  // Microsoft Clarity — tag is injected on idle so it stays out of the
  // initial load waterfall. The queue stub buffers calls until then.
  w.clarity=w.clarity||function(){(w.clarity.q=w.clarity.q||[]).push(arguments)};
  function load(){var s=d.createElement("script");s.async=1;s.src="https://www.clarity.ms/tag/"+id;d.head.appendChild(s)}
  if("requestIdleCallback" in w)w.requestIdleCallback(load,{timeout:4000});
  else w.addEventListener("load",function(){setTimeout(load,1500)});
})(window,document,${JSON.stringify(clarityId)});`}
      />
    )}
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>
  </head>
  <body class="bg-background text-ink antialiased">
    <header class="border-b border-border">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
          {/* Inline "ld" mark — same geometry as the PWA icon (scripts/generate-icons.mjs) */}
          <svg viewBox="0 0 512 512" class="h-6 w-6 shrink-0" aria-hidden="true">
            <rect x="0" y="0" width="512" height="512" rx="96" ry="96" fill="#2563eb" />
            <g fill="#ffffff">
              <rect x="145" y="120" width="46" height="260" rx="23" />
              <rect x="345" y="120" width="46" height="260" rx="23" />
              <path fill-rule="evenodd" d="M 300 208 a 92 92 0 1 0 0.1 0 Z M 300 248 a 52 52 0 1 0 0.1 0 Z" />
            </g>
          </svg>
          <span>local<span class="text-accent">dobe</span></span>
        </a>
        <div class="flex items-center gap-2 md:gap-6">
          <div class="hidden items-center gap-x-6 text-sm font-medium text-muted md:flex">
            <a href="/merge-pdf" class="hover:text-ink">Merge</a>
            <a href="/split-pdf" class="hover:text-ink">Split</a>
            <a href="/compress-pdf" class="hover:text-ink">Compress</a>
            <a href="/edit-pdf" class="hover:text-ink">Edit</a>
            <a href="/watermark-pdf" class="hover:text-ink">Watermark</a>
            <a href="/validate-pdf-signature" class="hover:text-ink">Signatures</a>
            <a href="/protect-pdf" class="hover:text-ink">Protect</a>
            <a href="/unlock-pdf" class="hover:text-ink">Unlock</a>
            <a href="/blog" class="hover:text-ink">Blog</a>
          </div>
          <button
            type="button"
            id="theme-toggle"
            data-testid="theme-toggle"
            aria-label="Toggle dark mode"
            class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg text-muted transition hover:bg-panel hover:text-ink"
          >
            <svg class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
            </svg>
            <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
          </button>
          <button
            type="button"
            id="nav-toggle"
            data-testid="nav-toggle"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-nav"
            class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg text-muted transition hover:bg-panel hover:text-ink md:hidden"
          >
            <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="nav-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>
      </nav>
      <div id="mobile-nav" class="hidden border-t border-border md:hidden">
        <div class="mx-auto grid max-w-6xl gap-1 px-4 py-3 text-base font-medium text-muted">
          <a href="/merge-pdf" class="rounded-lg px-3 py-2.5 hover:bg-panel hover:text-ink">Merge</a>
          <a href="/split-pdf" class="rounded-lg px-3 py-2.5 hover:bg-panel hover:text-ink">Split</a>
          <a href="/compress-pdf" class="rounded-lg px-3 py-2.5 hover:bg-panel hover:text-ink">Compress</a>
          <a href="/edit-pdf" class="rounded-lg px-3 py-2.5 hover:bg-panel hover:text-ink">Edit</a>
          <a href="/watermark-pdf" class="rounded-lg px-3 py-2.5 hover:bg-panel hover:text-ink">Watermark</a>
          <a href="/validate-pdf-signature" class="rounded-lg px-3 py-2.5 hover:bg-panel hover:text-ink">Signatures</a>
          <a href="/protect-pdf" class="rounded-lg px-3 py-2.5 hover:bg-panel hover:text-ink">Protect</a>
          <a href="/unlock-pdf" class="rounded-lg px-3 py-2.5 hover:bg-panel hover:text-ink">Unlock</a>
          <a href="/blog" class="rounded-lg px-3 py-2.5 hover:bg-panel hover:text-ink">Blog</a>
        </div>
      </div>
      <script>
        const navToggle = document.getElementById('nav-toggle');
        const mobileNav = document.getElementById('mobile-nav');
        const iconOpen = document.getElementById('nav-icon-open');
        const iconClose = document.getElementById('nav-icon-close');
        navToggle?.addEventListener('click', () => {
          const expanded = navToggle.getAttribute('aria-expanded') === 'true';
          navToggle.setAttribute('aria-expanded', String(!expanded));
          navToggle.setAttribute('aria-label', expanded ? 'Open menu' : 'Close menu');
          mobileNav?.classList.toggle('hidden', expanded);
          iconOpen?.classList.toggle('hidden', !expanded);
          iconClose?.classList.toggle('hidden', expanded);
        });
      </script>
    </header>
    <main><slot /></main>
    <footer class="mt-24 border-t border-border py-10 text-center text-sm text-muted">
      <p class="font-medium">No watermarks. No uploads. No signup.</p>
      <p class="mt-2">
        © 2026 localdobe · <a href="/privacy" class="underline">Privacy</a> · <a href="/about" class="underline">About</a> · <a href="/blog" class="underline">Blog</a>
      </p>
    </footer>
    <script is:inline>
      // Toggle click handler: placed after the button so it exists in the DOM already
      // (no DOMContentLoaded needed) — flips the class, persists the explicit choice,
      // and keeps the theme-color meta tag in sync.
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var next = !document.documentElement.classList.contains('dark');
          document.documentElement.classList.toggle('dark', next);
          localStorage.setItem('theme', next ? 'dark' : 'light');
          var meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', next ? '#0a0a0a' : '#2563eb');
        });
      })();
    </script>
  </body>
</html>
