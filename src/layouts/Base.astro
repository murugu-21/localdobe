---
import '../styles/global.css';
import { pwaInfo } from 'virtual:pwa-info';
import { toolGroups } from '../lib/tools';
import PostHog from '../components/posthog.astro';
import { Heart } from 'lucide-react';
import NavLinks from '../components/astro/NavLinks.astro';
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  jsonLd?: object[];
}
const { title, description, canonicalPath, jsonLd = [] } = Astro.props;
// Inlined at build time — set PUBLIC_CLARITY_PROJECT_ID as a Cloudflare build
// variable (the site is static; runtime Worker vars never reach this code).
// Clarity is here for session replay only; product events go to PostHog via
// src/lib/analytics.ts, which never calls window.clarity.
const clarityId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
const canonicalHref = new URL(canonicalPath, Astro.site).href;
const canonical = canonicalHref.endsWith('/') ? canonicalHref : `${canonicalHref}/`;
// Active nav state: match the page path with or without its trailing slash.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href;
const sponsorUrl = 'https://github.com/sponsors/murugu-21';
const supportEmail = 'murugu2001@gmail.com';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <PostHog />
    <script is:inline>
      // Blocking (no-FOUC) theme init: an explicit user choice in localStorage wins;
      // otherwise follow the OS/browser prefers-color-scheme. Runs before first paint —
      // must stay `is:inline` so Astro doesn't defer/bundle it as a module.
      (function () {
        var stored = localStorage.getItem('theme');
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
        var meta = document.getElementById('theme-color-meta');
        if (meta) meta.setAttribute('content', dark ? '#0a0a0a' : '#2563eb');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta id="theme-color-meta" name="theme-color" content="#2563eb" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="localdobe blog" href="/rss.xml" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    {clarityId && (
      <script
        is:inline
        set:html={`(function(w,d,id){
  // Microsoft Clarity — tag is injected on idle so it stays out of the
  // initial load waterfall. The queue stub buffers calls until then.
  w.clarity=w.clarity||function(){(w.clarity.q=w.clarity.q||[]).push(arguments)};
  function load(){var s=d.createElement("script");s.async=1;s.src="https://www.clarity.ms/tag/"+id;d.head.appendChild(s)}
  if("requestIdleCallback" in w)w.requestIdleCallback(load,{timeout:4000});
  else w.addEventListener("load",function(){setTimeout(load,1500)});
})(window,document,${JSON.stringify(clarityId)});`}
      />
    )}
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <style is:global>
      /* A <dialog> is display:none until opened, and the UA opens it as display:block —
         so the flex column has to be re-asserted for the open state. */
      #mobile-nav[open] {
        display: flex;
      }
      /* Slide in from the left. `allow-discrete` plus @starting-style are what let a
         display:none -> flex transition animate at all; browsers without them just show
         the drawer immediately, which is a perfectly good outcome. */
      #mobile-nav,
      #mobile-nav::backdrop {
        transition:
          translate 200ms ease-out,
          opacity 200ms ease-out,
          overlay 200ms allow-discrete,
          display 200ms allow-discrete;
      }
      #mobile-nav {
        translate: -100% 0;
      }
      #mobile-nav[open] {
        translate: 0 0;
      }
      #mobile-nav::backdrop {
        background: rgb(0 0 0 / 0.5);
        opacity: 0;
      }
      #mobile-nav[open]::backdrop {
        opacity: 1;
      }
      @starting-style {
        #mobile-nav[open] {
          translate: -100% 0;
        }
        #mobile-nav[open]::backdrop {
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        #mobile-nav,
        #mobile-nav::backdrop {
          transition: none;
        }
      }
    </style>
    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>
  </head>
  <body class="bg-background text-ink antialiased">
    <div class="flex min-h-screen">
      {/* Desktop sidebar — every tool one click away from every page (ilovepdf/ihatepdf
          dashboard pattern). Sticky so long pages don't scroll it away; only the tool
          list scrolls, keeping the logo and the Sponsor/theme bar pinned in view. */}
      <aside class="sticky top-0 hidden h-screen w-60 shrink-0 flex-col overflow-hidden border-r border-border lg:flex" aria-label="PDF tools">
        <a href="/" class="flex shrink-0 items-center gap-2 px-5 pt-5 pb-4 text-lg font-bold tracking-tight">
          {/* Inline "ld" mark — same geometry as the PWA icon (scripts/generate-icons.mjs) */}
          <svg viewBox="0 0 512 512" class="h-6 w-6 shrink-0" aria-hidden="true">
            <rect x="0" y="0" width="512" height="512" rx="96" ry="96" fill="#2563eb" />
            <g fill="#ffffff">
              <rect x="145" y="120" width="46" height="260" rx="23" />
              <rect x="345" y="120" width="46" height="260" rx="23" />
              <path fill-rule="evenodd" d="M 300 208 a 92 92 0 1 0 0.1 0 Z M 300 248 a 52 52 0 1 0 0.1 0 Z" />
            </g>
          </svg>
          <span>local<span class="text-accent">dobe</span></span>
        </a>
        <nav class="min-h-0 flex-1 overflow-y-auto px-3 pb-4">
          <NavLinks />
        </nav>
        <div class="grid shrink-0 gap-0.5 border-t border-border p-3">
          {/* Sponsor — the only ask on the site; localdobe has no ads and no paid tier.
              Pinned here rather than listed under Resources so it survives scrolling. */}
          <a
            href={sponsorUrl}
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-muted transition hover:bg-panel hover:text-ink"
          >
            <Heart className="h-4 w-4 shrink-0 fill-current text-sponsor" aria-hidden="true" />
            Sponsor
          </a>
          <button
            type="button"
            aria-label="Toggle dark mode"
            class="theme-toggle flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-muted transition hover:bg-panel hover:text-ink"
          >
            <svg class="block h-4 w-4 shrink-0 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
            </svg>
            <svg class="hidden h-4 w-4 shrink-0 dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <span class="block dark:hidden">Dark mode</span>
            <span class="hidden dark:block">Light mode</span>
          </button>
        </div>
      </aside>
      <div class="flex min-w-0 flex-1 flex-col">
        {/* Mobile header — the sidebar collapses into this hamburger drawer below lg. */}
        <header class="border-b border-border lg:hidden">
          <nav class="flex items-center justify-between px-4 py-3">
            <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
              <svg viewBox="0 0 512 512" class="h-6 w-6 shrink-0" aria-hidden="true">
                <rect x="0" y="0" width="512" height="512" rx="96" ry="96" fill="#2563eb" />
                <g fill="#ffffff">
                  <rect x="145" y="120" width="46" height="260" rx="23" />
                  <rect x="345" y="120" width="46" height="260" rx="23" />
                  <path fill-rule="evenodd" d="M 300 208 a 92 92 0 1 0 0.1 0 Z M 300 248 a 52 52 0 1 0 0.1 0 Z" />
                </g>
              </svg>
              <span>local<span class="text-accent">dobe</span></span>
            </a>
            <div class="flex items-center gap-2">
              <button
                type="button"
                data-testid="theme-toggle"
                aria-label="Toggle dark mode"
                class="theme-toggle inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-muted transition hover:bg-panel hover:text-ink"
              >
                <svg class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
                </svg>
                <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
                </svg>
              </button>
              <button
                type="button"
                id="nav-toggle"
                data-testid="nav-toggle"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile-nav"
                class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-muted transition hover:bg-panel hover:text-ink"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M4 6h16M4 12h16M4 18h16" />
                </svg>
              </button>
            </div>
          </nav>
        </header>

        {/* Mobile drawer — an overlay panel rather than an in-flow accordion: opening
            the menu used to push the whole page down by its full height (~900px on a
            phone), so the content you came for scrolled off screen. `invisible` when
            closed keeps its links out of the tab order and the a11y tree, and lets the
            slide-out finish before the panel disappears. */}
        <dialog
          id="mobile-nav"
          aria-label="PDF tools"
          class="m-0 mr-auto h-dvh max-h-dvh w-[min(20rem,85vw)] max-w-none flex-col overflow-hidden border-0 border-r border-border bg-background p-0 text-ink lg:hidden"
        >
          <div class="flex shrink-0 items-center justify-between px-4 pt-4 pb-2">
            <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
              <svg viewBox="0 0 512 512" class="h-6 w-6 shrink-0" aria-hidden="true">
                <rect x="0" y="0" width="512" height="512" rx="96" ry="96" fill="#2563eb" />
                <g fill="#ffffff">
                  <rect x="145" y="120" width="46" height="260" rx="23" />
                  <rect x="345" y="120" width="46" height="260" rx="23" />
                  <path fill-rule="evenodd" d="M 300 208 a 92 92 0 1 0 0.1 0 Z M 300 248 a 52 52 0 1 0 0.1 0 Z" />
                </g>
              </svg>
              <span>local<span class="text-accent">dobe</span></span>
            </a>
            <button
              type="button"
              id="nav-close"
              autofocus
              aria-label="Close menu"
              class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-muted transition hover:bg-panel hover:text-ink"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>
          </div>
          <nav class="min-h-0 flex-1 overflow-y-auto px-3 pb-4">
            <NavLinks size="md" />
          </nav>
          {/* Sponsor pins to the bottom as it does on the desktop rail. The theme
              toggle stays in the header instead, where it is reachable without
              opening the drawer at all. */}
          <div class="shrink-0 border-t border-border p-3">
            <a href={sponsorUrl} target="_blank" rel="noopener" class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-base font-medium text-muted transition hover:bg-panel hover:text-ink">
              <Heart className="h-4 w-4 shrink-0 fill-current text-sponsor" aria-hidden="true" />
              Sponsor
            </a>
          </div>
        </dialog>
        <script>
          // The drawer is a native <dialog>. showModal() supplies the focus trap,
          // Escape-to-close, the backdrop and inert-behind — all the parts a div
          // overlay has to hand-roll and usually gets subtly wrong. It also restores
          // focus to the hamburger on close by itself.
          const navToggle = document.getElementById('nav-toggle');
          const navClose = document.getElementById('nav-close');
          const drawer = document.getElementById('mobile-nav') as HTMLDialogElement | null;

          navToggle?.addEventListener('click', () => {
            drawer?.showModal();
            navToggle.setAttribute('aria-expanded', 'true');
            // The one thing showModal() does not do: stop the page underneath from
            // scrolling under your finger.
            document.body.style.overflow = 'hidden';
          });
          navClose?.addEventListener('click', () => drawer?.close());
          // A click landing on the dialog element itself is a click on the backdrop —
          // the panel's own children cover everything else.
          drawer?.addEventListener('click', (event) => {
            if (event.target === drawer) drawer.close();
          });
          // Fires for the close button, Escape and the backdrop alike.
          drawer?.addEventListener('close', () => {
            navToggle?.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
          });
        </script>
        <main class="flex-1"><slot /></main>
        <footer class="mt-24 border-t border-border py-10 text-center text-sm text-muted">
          <p class="font-medium">No watermarks. No uploads. No signup.</p>
          <p class="mt-2">
            © 2026 localdobe · <a href="/privacy/" class="underline">Privacy</a> · <a href="/about/" class="underline">About</a> · <a href={`mailto:${supportEmail}`} class="underline">Contact</a> · <a href="/blog/" class="underline">Blog</a> · <a href="https://github.com/murugu-21/localdobe" class="underline" target="_blank" rel="noopener">Open source</a>
          </p>
          <p class="mt-3">
            No ads, no paid tier —{' '}
            <a href={sponsorUrl} class="font-medium text-sponsor underline underline-offset-2" target="_blank" rel="noopener">sponsor localdobe</a>{' '}
            if it saved you a download.
          </p>
        </footer>
      </div>
    </div>
    <script>
      // Site-level analytics. One delegated listener rather than a handler per link:
      // the sidebar, the mobile drawer, the landing-page cards and the related-tool
      // links all render the same tool hrefs, and this records which surface a visit
      // actually came from — the input for deciding which tool to build next.
      import { track, toolFromPath } from '../lib/analytics';

      function surface(el: Element): string {
        if (el.closest('#mobile-nav')) return 'mobile-nav';
        if (el.closest('aside')) return 'sidebar';
        if (el.closest('footer')) return 'footer';
        if (el.closest('header')) return 'header';
        return 'page';
      }

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest('a[href]');
        if (!link) return;
        const href = link.getAttribute('href') ?? '';

        if (href.includes('github.com/sponsors')) {
          track('sponsor_clicked', { location: surface(link) });
          return;
        }
        // Same-origin only: `new URL` on an external href would still parse, so the
        // tool allowlist below is what keeps this from tagging outbound links.
        const tool = toolFromPath(new URL(href, window.location.origin).pathname);
        if (tool) track('nav_tool_clicked', { target_tool: tool, location: surface(link) });
      });
    </script>
    <script is:inline>
      // Toggle click handler: placed after the buttons so they exist in the DOM already
      // (no DOMContentLoaded needed). Two toggles exist — sidebar (desktop) and header
      // (mobile) — so bind by class; each flips the class, persists the explicit
      // choice, and keeps the theme-color meta tag in sync.
      (function () {
        document.querySelectorAll('.theme-toggle').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var next = !document.documentElement.classList.contains('dark');
            document.documentElement.classList.toggle('dark', next);
            localStorage.setItem('theme', next ? 'dark' : 'light');
            var meta = document.getElementById('theme-color-meta');
            if (meta) meta.setAttribute('content', next ? '#0a0a0a' : '#2563eb');
          });
        });
      })();
    </script>
  </body>
</html>
