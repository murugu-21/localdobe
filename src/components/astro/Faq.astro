---
interface Props { items: { q: string; a: string; link?: { href: string; label: string } }[] }
const { items } = Astro.props;
---
<section class="not-prose mt-10">
  <h2 class="text-2xl font-bold">Frequently asked questions</h2>
  <div class="mt-4 divide-y divide-border">
    {items.map(({ q, a, link }) => (
      <details class="group py-4">
        <summary class="cursor-pointer font-semibold marker:content-none">{q}</summary>
        <p class="mt-2 text-muted">
          {a}
          {link && <> <a href={link.href} class="font-medium text-accent underline underline-offset-2 hover:text-ink">{link.label}</a></>}
        </p>
      </details>
    ))}
  </div>
</section>
