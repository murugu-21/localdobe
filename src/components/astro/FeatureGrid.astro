---
const features = [
  { icon: '🔒', title: 'Private by architecture', desc: 'Processing runs entirely in your browser. There is no server to upload to — disconnect from the internet and the tools keep working.' },
  { icon: '💧', title: 'No watermarks, ever', desc: 'Your exported PDF contains your document and nothing else. No stamps, no branding, no "upgrade to remove".' },
  { icon: '⚡', title: 'Fast and free', desc: 'No queues, no file limits tied to a paywall, no accounts. Your hardware does the work, so we don’t have to charge for servers.' },
  { icon: '📡', title: 'Works offline', desc: 'After your first visit, every tool runs without internet. Install localdobe as an app and use it on a plane.' },
];
---
<section class="mx-auto mt-24 grid max-w-5xl gap-8 px-4 sm:grid-cols-2 lg:grid-cols-4">
  {features.map((f) => (
    <div>
      <span class="text-2xl" aria-hidden>{f.icon}</span>
      <h2 class="mt-2 text-lg font-bold">{f.title}</h2>
      <p class="mt-1 text-sm text-muted">{f.desc}</p>
    </div>
  ))}
</section>
