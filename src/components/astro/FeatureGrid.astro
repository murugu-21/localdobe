---
const features = [
  { icon: '💻', title: 'Nothing to install', desc: 'The full toolkit runs in the browser you already have. No gigabyte desktop suite, no admin rights, no update nags, no bundled extras you didn’t ask for.' },
  { icon: '🔒', title: 'Nothing to upload', desc: 'Processing runs entirely in your browser — there is no server your file could be retained on. Disconnect from the internet and the tools keep working.' },
  { icon: '💧', title: 'No watermarks, ever', desc: 'Your exported PDF contains your document and nothing else. No stamps, no branding, no "upgrade to remove".' },
  { icon: '📡', title: 'Free, and works offline', desc: 'No queues, no paywalled limits, no accounts. After your first visit every tool runs without internet — install localdobe as an app and use it on a plane.' },
];
---
<section class="mx-auto mt-24 grid max-w-5xl gap-8 px-4 sm:grid-cols-2 lg:grid-cols-4">
  {features.map((f) => (
    <div>
      <span class="pointer-events-none block select-none text-2xl" aria-hidden>{f.icon}</span>
      <h2 class="mt-2 text-lg font-bold">{f.title}</h2>
      <p class="mt-1 text-sm text-muted">{f.desc}</p>
    </div>
  ))}
</section>
