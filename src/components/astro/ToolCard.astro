---
/** `icon` is lucide-style inner SVG markup from src/lib/tools.ts. */
interface Props { href: string; title: string; desc: string; icon: string }
const { href, title, desc, icon } = Astro.props;
---
<a href={href} class="group rounded-2xl border border-border p-5 transition hover:border-accent hover:shadow-lg">
  <span class="inline-flex size-10 items-center justify-center rounded-xl bg-primary/10 text-accent" aria-hidden="true">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <Fragment set:html={icon} />
    </svg>
  </span>
  <h3 class="mt-3 text-base font-bold group-hover:text-accent">{title}</h3>
  <p class="mt-1 text-sm text-muted">{desc}</p>
</a>
