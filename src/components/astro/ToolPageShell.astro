---
interface Props { h1: string; sub: string }
const { h1, sub } = Astro.props;
---
<section class="mx-auto max-w-3xl px-4 pt-12 text-center">
  <h1 class="text-4xl font-extrabold tracking-tight">{h1}</h1>
  <p class="mx-auto mt-3 max-w-xl text-lg text-muted">{sub}</p>
  <p class="mt-2 text-sm font-semibold text-accent">No watermarks. No uploads. No signup.</p>
  {/* Session replays must never capture document content — file names, pdf.js text
      layers, rendered pages — only masked placeholders. The tool components mark just
      those elements (see src/lib/replay.ts); the wrapper itself stays unblocked so the
      buttons, options and layout remain visible in replays. Do not wrap the whole slot:
      that hid every control from the recordings. */}
  <div class="mt-8 text-left"><slot name="tool" /></div>
</section>
<article class="prose prose-slate mx-auto mt-20 max-w-3xl px-4 dark:prose-invert">
  <slot />
</article>

{/* Top of the funnel. Every tool page renders through this shell, so one script
    here records the view for all of them — the tool is derived from the URL. */}
<script>
  import { track } from '../../lib/analytics';
  track('tool_viewed');
</script>
