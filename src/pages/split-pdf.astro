---
import Base from '../layouts/Base.astro';
import ToolPageShell from '../components/astro/ToolPageShell.astro';
import Faq from '../components/astro/Faq.astro';
import SplitTool from '../components/tools/SplitTool';
import { webAppJsonLd, faqJsonLd } from '../lib/seo';

const faq = [
  { q: 'Is this PDF splitter really free?', a: 'Yes — completely free, with no watermark, no signup, and no page caps. The split runs on your own device, so there are no server costs to pass on and nothing to upsell.' },
  { q: 'Can I extract just one page?', a: 'Yes — tap its thumbnail (page selection opens by default) and hit the button. Or type its number under “Type ranges”.' },
  { q: 'How do I split every page into its own file?', a: 'Choose the “Split all” tab. You’ll get a zip with one PDF per page, created locally.' },
  { q: 'Do multiple ranges become one file or many?', a: 'Each range downloads as its own PDF by default. Flip on “Merge into a single PDF” to combine everything you picked into one document instead.' },
  { q: 'Is there a file size or page limit?', a: 'No arbitrary limits. Because nothing is uploaded, there’s no server quota — the only bound is your device’s memory, and even large scanned documents with hundreds of pages split fine.' },
  { q: 'Can I split a password-protected PDF?', a: 'PDFs with only editing restrictions (an owner password) open and split automatically. If the PDF requires a password to open, remove it first with the free Unlock PDF tool, then split the unlocked copy — both steps happen locally in your browser.' },
  { q: 'Does splitting reduce quality?', a: 'No. Pages are copied losslessly — fonts, images, and vectors are untouched.' },
  { q: 'Does it work on Mac, Windows, iPhone, and Android?', a: 'Yes. It runs in any modern browser — Windows, macOS, Linux, ChromeOS, iOS, and Android — with nothing to install.' },
  { q: 'Can I split a PDF without uploading it?', a: 'Yes. The split happens entirely in your browser — your file never leaves your device, and nothing is transmitted, logged, or stored.' },
];
const description = 'Split a PDF online free: extract specific pages, split by page range, or save every page as its own PDF. No upload, no watermark, no signup — 100% local.';
---
<Base title="Split PDF Online Free — Extract Pages, No Watermark | localdobe" {description} canonicalPath="/split-pdf"
  jsonLd={[webAppJsonLd('Split PDF', '/split-pdf', description), faqJsonLd(faq)]}>
  <ToolPageShell h1="Split PDF" sub="Extract pages or split a PDF into multiple files — free, online, right in your browser.">
    <SplitTool client:load slot="tool" />
    <h2>How to split a PDF</h2>
    <ol>
      <li>Drop your PDF into the box above (or click to browse).</li>
      <li>Tap the page thumbnails you want, type ranges like <code>1-3, 5, 7-</code> under <strong>Type ranges</strong>, or pick <strong>Split all</strong> for one file per page.</li>
      <li>Each range comes back as its own PDF — or flip on <strong>Merge into a single PDF</strong> to combine your picks into one document.</li>
      <li>Hit the button and download the result.</li>
    </ol>
    <h2>Three ways to split a PDF file</h2>
    <ul>
      <li><strong>Extract pages from a PDF.</strong> Tap the thumbnails of the pages you need — the signature page, one chapter, a single form — and get a new PDF with just those pages. The original stays untouched. There’s also a dedicated <a href="/extract-pdf-pages/">extract pages tool</a> that opens with extraction defaults.</li>
      <li><strong>Split a PDF into multiple files by page range.</strong> Type ranges like <code>1-4, 5-9, 10-</code> and each range becomes its own PDF. Turn on <strong>Merge into a single PDF</strong> to combine your selection into one document instead.</li>
      <li><strong>Split a PDF into separate pages.</strong> The <strong>Split all</strong> tab saves every page as its own individual PDF, delivered in a single zip.</li>
    </ul>
    <h2>A free PDF splitter with no watermark</h2>
    <p>Most “free” PDF splitters upload your document to their servers before handing back a few pages. That means a full copy of your file — including the pages you didn’t ask for — sits on someone else’s machine, and the free tier usually caps your pages or stamps a watermark. localdobe splits entirely inside your browser tab: nothing is transmitted, logged, or stored, and the output carries no watermark, no page cap, and no signup wall.</p>
    <h2>Split a PDF without Adobe Acrobat — on any device</h2>
    <p>There’s nothing to install. The splitter runs in any modern browser on Windows, macOS, Linux, ChromeOS, iPhone, or Android, so you can separate PDF pages on a work laptop with no admin rights or on your phone. After your first visit it even works offline. Need the reverse? <a href="/merge-pdf/">Merge PDFs</a> back together, <a href="/compress-pdf/">compress the result</a> for email, or <a href="/unlock-pdf/">unlock a password-protected PDF</a> before splitting it.</p>
    <p>Want the details? Read <a href="/blog/split-pdf-into-separate-pages/">how to split a PDF into separate pages</a> and <a href="/blog/extract-pages-from-pdf/">how to extract specific pages from a PDF</a>.</p>
    <Faq items={faq} />
  </ToolPageShell>
</Base>
