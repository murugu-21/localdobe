---
import Base from '../layouts/Base.astro';
import ToolPageShell from '../components/astro/ToolPageShell.astro';
import Faq from '../components/astro/Faq.astro';
import SplitTool from '../components/tools/SplitTool';
import { webAppJsonLd, faqJsonLd } from '../lib/seo';

const faq = [
  { q: 'Can I extract just one page?', a: 'Yes — tap its thumbnail (page selection opens by default) and hit the button. Or type its number under “Type ranges”.' },
  { q: 'How do I split every page into its own file?', a: 'Choose the “Split all” tab. You’ll get a zip with one PDF per page, created locally.' },
  { q: 'Do multiple ranges become one file or many?', a: 'Each range downloads as its own PDF by default. Flip on “Merge into a single PDF” to combine everything you picked into one document instead.' },
  { q: 'Does splitting reduce quality?', a: 'No. Pages are copied losslessly — fonts, images, and vectors are untouched.' },
  { q: 'Are my files uploaded?', a: 'Never. The split happens in your browser; your PDF stays on your device.' },
];
const description = 'Split a PDF or extract specific pages free, with no watermark and no upload. Everything runs locally in your browser.';
---
<Base title="Split PDF — extract pages free, no upload | localdobe" {description} canonicalPath="/split-pdf"
  jsonLd={[webAppJsonLd('Split PDF', '/split-pdf', description), faqJsonLd(faq)]}>
  <ToolPageShell h1="Split a PDF" sub="Extract pages or break a PDF apart — locally, in your browser.">
    <SplitTool client:load slot="tool" />
    <h2>How to split a PDF</h2>
    <ol>
      <li>Drop your PDF into the box above (or click to browse).</li>
      <li>Tap the page thumbnails you want, type ranges like <code>1-3, 5, 7-</code> under <strong>Type ranges</strong>, or pick <strong>Split all</strong> for one file per page.</li>
      <li>Each range comes back as its own PDF — or flip on <strong>Merge into a single PDF</strong> to combine your picks into one document.</li>
      <li>Hit the button and download the result.</li>
    </ol>
    <h2>Why splitting locally matters</h2>
    <p>Most “free” PDF splitters upload your document to their servers before handing back a few pages. That means a full copy of your file — including the pages you didn’t ask for — sits on someone else’s machine. localdobe splits entirely inside your browser tab: nothing is transmitted, logged, or stored.</p>
    <p>Want the details? Read <a href="/blog/split-pdf-into-separate-pages">how to split a PDF into separate pages</a> and <a href="/blog/extract-pages-from-pdf">how to extract specific pages from a PDF</a>.</p>
    <Faq items={faq} />
  </ToolPageShell>
</Base>
