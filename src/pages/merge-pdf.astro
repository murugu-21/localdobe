---
import Base from '../layouts/Base.astro';
import ToolPageShell from '../components/astro/ToolPageShell.astro';
import Faq from '../components/astro/Faq.astro';
import MergeTool from '../components/tools/MergeTool';
import { webAppJsonLd, faqJsonLd } from '../lib/seo';

const faq = [
  { q: 'Is this merge tool really free?', a: 'Yes. No watermarks, no page limits, no signup. The tool runs in your browser, so it costs us almost nothing to offer.' },
  { q: 'Are my PDFs uploaded to a server?', a: 'No. Merging happens locally in your browser. Your files never leave your device — you can even disconnect from the internet after the page loads.' },
  { q: 'Can I change the order of the files?', a: 'Yes. After adding files, drag them into the order you want (or use the arrows) before merging.' },
  { q: 'Is there a file size limit?', a: 'Only your device’s memory. Files in the hundreds of megabytes work on most modern computers.' },
  { q: 'Can I combine PDFs without uploading them?', a: 'Yes — that’s the whole point. Merging happens locally in your browser, so your files never leave your device. Disconnect from the internet after the page loads and it still works.' },
  { q: 'Can I combine a PDF with a JPG or PNG image?', a: 'Yes. Add any mix of PDFs and supported image files and they’ll be combined into a single PDF in the order you arrange them.' },
];
const description = 'Merge PDF files free, with no watermark and no upload. Combining happens locally in your browser — your files never leave your device.';
---
<Base title="Merge PDF — free, local, no watermark | localdobe" {description} canonicalPath="/merge-pdf"
  jsonLd={[webAppJsonLd('Merge PDF', '/merge-pdf', description), faqJsonLd(faq)]}>
  <ToolPageShell h1="Merge PDF files" sub="Combine multiple PDFs into one — right here in your browser.">
    <MergeTool client:load slot="tool" />
    <h2>How to merge PDF files</h2>
    <ol>
      <li>Drop two or more PDF files into the box above (or click to browse).</li>
      <li>Drag the files into the order you want — the first file starts the merged PDF.</li>
      <li>Click <strong>Merge</strong> and download your combined PDF.</li>
    </ol>
    <h2>Why merging locally matters</h2>
    <p>Most “free” PDF sites upload your documents to their servers. That means your contracts, statements, and records sit on someone else’s machine, subject to their retention policy. localdobe is different: the merge runs inside your browser tab, using the same kind of technology that powers modern web apps like Figma. Nothing is transmitted, logged, or stored.</p>
    <p>Want the details? Read <a href="/blog/merge-pdfs-without-uploading/">how to merge PDFs without uploading them anywhere</a> and <a href="/blog/are-online-pdf-tools-safe/">what actually happens to your files on online PDF tools</a>.</p>
    <Faq items={faq} />
  </ToolPageShell>
</Base>
