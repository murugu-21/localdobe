---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="Blog — PDF privacy, tips, and how-tos | localdobe"
  description="Guides on working with PDFs privately: merging, splitting, compressing, and editing without uploading your documents anywhere."
  canonicalPath="/blog">
  <section class="mx-auto max-w-3xl px-4 pt-12">
    <h1 class="text-4xl font-extrabold">Blog</h1>
    <p class="mt-2 text-muted">PDF how-tos and why your documents deserve to stay on your device.</p>
    <div class="mt-10 space-y-8">
      {posts.map((p) => (
        <a href={`/blog/${p.id}`} class="block rounded-xl border border-slate-200 p-6 hover:border-accent">
          <h2 class="text-xl font-bold">{p.data.title}</h2>
          <p class="mt-2 text-muted">{p.data.description}</p>
          <time class="mt-2 block text-xs text-muted" datetime={p.data.pubDate.toISOString()}>
            {p.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </a>
      ))}
    </div>
  </section>
</Base>
