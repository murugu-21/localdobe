---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { articleJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} | localdobe`} description={post.data.description}
  canonicalPath={`/blog/${post.id}`}
  jsonLd={[articleJsonLd(post.data.title, post.data.description, post.id, post.data.pubDate)]}>
  <article class="prose prose-slate mx-auto max-w-3xl px-4 pt-12">
    <h1>{post.data.title}</h1>
    <time class="text-sm text-muted" datetime={post.data.pubDate.toISOString()}>
      {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
    <Content />
  </article>
</Base>
