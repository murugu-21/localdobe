---
import Base from '../layouts/Base.astro';
import ToolPageShell from '../components/astro/ToolPageShell.astro';
import Faq from '../components/astro/Faq.astro';
import CompressTool from '../components/tools/CompressTool';
import { webAppJsonLd, faqJsonLd } from '../lib/seo';

const faq = [
  { q: 'Can I compress a PDF without losing quality?', a: 'Yes. localdobe removes redundancy (duplicate fonts, unused objects, repeated streams) rather than recompressing your images, so pages look identical — your file gets smaller with no visible quality hit.' },
  { q: 'Can I compress a PDF to a specific size?', a: 'Not to an exact byte count — results depend on the file’s contents. But Maximum gives you the smallest file, and PDFs with duplicated fonts, unused objects, or repeated content streams often drop by 20–70%, which is usually enough to get under an email or upload limit.' },
  { q: 'Can I compress a PDF for email?', a: 'Yes. Run compression to shed the biggest overhead first — for most email providers that accept up to 20–25 MB, that’s enough. If the file is still too big, splitting it and sending the relevant pages can help.' },
  { q: 'Why is the first compression slow?', a: 'Your browser downloads the compression engine once (a few MB compressed), then caches it. After that it starts instantly — even offline.' },
  { q: 'Is my PDF uploaded?', a: 'No. The engine runs inside a Web Worker in your browser. Your file never touches a server.' },
];
const description = 'Reduce a PDF file size without losing quality — free, no upload, no watermark. A real compression engine that runs entirely on your device.';
---
<Base title="Compress PDF — free, offline, no watermark | localdobe" {description} canonicalPath="/compress-pdf"
  jsonLd={[webAppJsonLd('Compress PDF', '/compress-pdf', description), faqJsonLd(faq)]}>
  <ToolPageShell h1="Compress a PDF" sub="Shrink your PDF with a real compression engine running in your browser.">
    <CompressTool client:load slot="tool" />
    <h2>How to compress a PDF</h2>
    <ol>
      <li>Drop your PDF into the box above (or click to browse).</li>
      <li>Pick a compression level — Light, Balanced, or Maximum.</li>
      <li>Click <strong>Compress PDF</strong> and download the smaller file.</li>
    </ol>
    <h2>How it works</h2>
    <p>localdobe’s compression is built on trusted, battle-tested open-source PDF software — the same kind of professional PDF technology used by developers everywhere — running directly on your device instead of on a server. Instead of uploading your document for processing, that engine runs quietly in the background of your browser tab: no upload, no queue, no server round-trip. The first run downloads the compression engine once (a one-time download, cached after that); every run after that starts instantly, even offline. Curious exactly how a browser can do this? Read <a href="/blog/webassembly-pdf-tools/">WebAssembly: how your browser became a PDF powerhouse</a>.</p>
    <p>Compression itself works by removing redundancy rather than recompressing images: duplicate fonts, unused objects, and repeated content streams are deduplicated and stripped out. Want the full technical breakdown? Read <a href="/blog/pdf-compression-explained/">how PDF compression actually works</a>.</p>
    <h2>Compress to a specific size</h2>
    <p>Need your PDF under a particular limit — like an email or upload cap? Pick a target size and we'll aim for it: <a href="/compress-pdf/to-100kb/">100 KB</a>, <a href="/compress-pdf/to-200kb/">200 KB</a>, <a href="/compress-pdf/to-500kb/">500 KB</a>, <a href="/compress-pdf/to-1mb/">1 MB</a>, <a href="/compress-pdf/to-2mb/">2 MB</a>, or <a href="/compress-pdf/to-5mb/">5 MB</a>.</p>
    <Faq items={faq} />
  </ToolPageShell>
</Base>
